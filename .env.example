# انسخ الملف ده لـ .env وعدّل القيم — راجع INSTALL.md لشرح كل واحدة

# المنفذ اللي هيوصل منه المستخدمين للتطبيق (http://server:HTTP_PORT)
HTTP_PORT=80

# بريد يستلم نسخة إشعار كل عملية استعادة كلمة مرور (OTP) لغير الأدمن.
# سيبه فاضي لو مش عايز الميزة دي.
OTP_NOTIFY_EMAIL=

# كلمة المرور الافتراضية لأي حساب جديد — غيّرها ونفس القيمة لازم تتحط
# في frontend/src/constants.js (DEFAULT_PASSWORD) كمان قبل ما تعمل build.
DEFAULT_PASSWORD=Mobica@2024

# مفتاح تشفير الجلسات (JWT). سيبه فاضي عشان يتولّد تلقائيًا ويتحفظ —
# الخيار الأأمن لمعظم الحالات. حدده بنفسك بس لو محتاج قيمة ثابتة معروفة
# (مثلاً عندك أكتر من نسخة باك-إند لازم تشارك نفس التوكنات).
JWT_SECRET=
